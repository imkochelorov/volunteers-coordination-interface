# Set your own strong password before first boot. Required for a new database.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

HOST=127.0.0.1
PORT=4319
DATABASE_PATH=./data/app.sqlite

# Create a NEW bot with BotFather. Do not commit real credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# For HTTPS behind a reverse proxy, set the exact external origin and enable secure cookies.
PUBLIC_ORIGIN=
SECURE_COOKIES=0
